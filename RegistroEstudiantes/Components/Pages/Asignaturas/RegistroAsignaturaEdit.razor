@page "/asignaturas/edit/{AsignaturaId:int}"
@using RegistroEstudiantes.Services
@inject AsignaturaService asignaturaService
@inject NavigationManager navigationManager
@inject AlertaService alertaService
@rendermode InteractiveServer

<h3>Editar Asignatura</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-danger">@mensaje</div>
}

<EditForm Model="asignatura" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Codigo</label>
        <InputText class="form-control" @bind-Value="asignatura.Codigo" />
        <ValidationMessage For="@(() => asignatura.Codigo)" />
    </div>

    <div class="mb-3">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="asignatura.Nombre" />
        <ValidationMessage For="@(() => asignatura.Nombre)" />
    </div>

    <div class="mb-3">
        <label>Aula</label>
        <InputText class="form-control" @bind-Value="asignatura.Aula" />
        <ValidationMessage For="@(() => asignatura.Aula)" />
    </div>

    <div class="mb-3">
        <label>Creditos</label>
        <InputNumber class="form-control" @bind-Value="asignatura.Creditos" />
        <ValidationMessage For="@(() => asignatura.Creditos)" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <button type="button" class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
    <a href="/asignaturas/index" class="btn btn-secondary">Volver</a>
</EditForm>

@code {
    [Parameter]
    public int AsignaturaId { get; set; }

    public AsignaturaEntity asignatura { get; set; } = new AsignaturaEntity();
    public string mensaje { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var encontrado = await asignaturaService.Buscar(AsignaturaId);
        if (encontrado != null)
        {
            asignatura = encontrado;
        }
    }

    private async Task Modificar()
    {
        if (await asignaturaService.Guardar(asignatura))
        {
            alertaService.Mostrar("Asignatura modificada correctamente", "success");

            navigationManager.NavigateTo("/asignaturas/index");
        }
        else
        {
            mensaje = "No se pudo modificar la asignatura";
        }
    }

    private async Task Eliminar()
    {
        if (await asignaturaService.Eliminar(AsignaturaId))
        {
            alertaService.Mostrar("Asignatura eliminada correctamente", "warning");

            navigationManager.NavigateTo("/asignaturas/index");
        }
        else
        {
            mensaje = "No se pudo eliminar la asignatura";
        }
    }
}
