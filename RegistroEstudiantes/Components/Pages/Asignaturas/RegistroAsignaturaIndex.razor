@page "/asignaturas/index"
@inject AsignaturaService asignaturaService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Registro de Asignaturas</h5>
        <a href="/asignaturas/create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Crear
        </a>
    </div>

    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label text-secondary">Filtrar por</label>
                <select class="form-select" @bind="filtro">
                    <option value="" selected disabled>Elija una opcion</option>
                    <option value="id">AsignaturaId</option>
                    <option value="codigo">Codigo</option>
                    <option value="nombre">Nombre</option>
                </select>
            </div>
            <div class="col-md-8">
                <label class="form-label text-secondary">Busqueda</label>
                <div class="input-group">
                    <input class="form-control" @bind="valorFiltro" placeholder="Buscar" />
                    <button class="btn btn-outline-primary" @onclick="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">AsignaturaId</th>
                        <th scope="col">Codigo</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Aula</th>
                        <th scope="col">Creditos</th>
                        <th scope="col">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        <tr>
                            <td>@item.AsignaturaId</td>
                            <td>@item.Codigo</td>
                            <td>@item.Nombre</td>
                            <td>@item.Aula</td>
                            <td><strong>@item.Creditos</strong></td>
                            <td>
                                <a href="/asignaturas/edit/@item.AsignaturaId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer text-muted">
        Cantidad: @lista.Count
    </div>
</div>

@code {
    public List<AsignaturaEntity> lista { get; set; } = new List<AsignaturaEntity>();
    public string filtro { get; set; } = "id";
    public string valorFiltro { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        lista = await asignaturaService.ObtenerTodos();
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(valorFiltro))
        {
            lista = await asignaturaService.ObtenerTodos();
        }
        else
        {
            if (filtro == "id" && int.TryParse(valorFiltro, out int id))
            {
                var resultado = await asignaturaService.Buscar(id);
                lista = resultado != null ? new List<AsignaturaEntity> { resultado } : new List<AsignaturaEntity>();
            }
            else if (filtro == "codigo")
            {
                var todos = await asignaturaService.ObtenerTodos();
                lista = todos.Where(a => a.Codigo.ToLower().Contains(valorFiltro.ToLower())).ToList();
            }
            else if (filtro == "nombre")
            {
                var todos = await asignaturaService.ObtenerTodos();
                lista = todos.Where(a => a.Nombre.ToLower().Contains(valorFiltro.ToLower())).ToList();
            }
        }
    }
}