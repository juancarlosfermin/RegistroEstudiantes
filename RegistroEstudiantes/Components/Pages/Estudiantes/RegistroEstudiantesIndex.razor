@page "/estudiantes/index"
@inject EstudianteService estudianteService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<h3>Indice de Estudiantes</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="input-group">
            <input class="form-control" @bind="filtro" placeholder="Buscar por nombre..." />
            <button class="btn btn-primary" @onclick="Buscar">Buscar</button>
        </div>
    </div>
    <div class="col-md-3 text-end">
        <a href="/estudiantes/create" class="btn btn-success">Crear Nuevo</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombres</th>
            <th>Email</th>
            <th>Edad</th>
            <th>Editar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in lista)
        {
            <tr>
                <td>@item.EstudianteId</td>
                <td>@item.Nombres</td>
                <td>@item.Email</td>
                <td>@item.Edad</td>
                <td>
                    <a href="/estudiantes/edit/@item.EstudianteId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    public List<EstudianteEntity> lista { get; set; } = new List<EstudianteEntity>();
    public string filtro { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        lista = await estudianteService.ObtenerTodos();
    }

    private async Task Buscar()
    {
        var todos = await estudianteService.ObtenerTodos();

        if (!string.IsNullOrWhiteSpace(filtro))
        {
            lista = todos.Where(e => e.Nombres.ToLower().Contains(filtro.ToLower())).ToList();
        }
        else
        {
            lista = todos;
        }
    }
}
