@page "/estudiantes/edit/{EstudianteId:int}"
@inject EstudianteService estudianteService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<h3>Editar Estudiante</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-danger">@mensaje</div>
}

<EditForm Model="estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Nombres</label>
        <InputText class="form-control" @bind-Value="estudiante.Nombres" />
        <ValidationMessage For="@(() => estudiante.Nombres)" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="estudiante.Email" />
        <ValidationMessage For="@(() => estudiante.Email)" />
    </div>

    <div class="mb-3">
        <label>Edad</label>
        <InputNumber class="form-control" @bind-Value="estudiante.Edad" />
        <ValidationMessage For="@(() => estudiante.Edad)" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <button type="button" class="btn btn-danger" @onclick="Eliminar">Eliminar</button>
    <a href="/estudiantes/index" class="btn btn-secondary">Volver</a>
</EditForm>

@code {
    [Parameter]
    public int EstudianteId { get; set; }

    public EstudianteEntity estudiante { get; set; } = new EstudianteEntity();
    public string mensaje { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var encontrado = await estudianteService.Buscar(EstudianteId);
        if (encontrado != null)
        {
            estudiante = encontrado;
        }
    }

    private async Task Modificar()
    {
        if (await estudianteService.Modificar(estudiante))
        {
            navigationManager.NavigateTo("/estudiantes/index");
        }
        else
        {
            mensaje = "No se pudo modificar el estudiante.";
        }
    }

    private async Task Eliminar()
    {
        if (await estudianteService.Eliminar(EstudianteId))
        {
            navigationManager.NavigateTo("/estudiantes/index");
        }
        else
        {
            mensaje = "No se pudo eliminar el estudiante.";
        }
    }
}